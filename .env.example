# Copy to local/.env and fill in. Never commit the real file.
OPENAI_API_KEY=
PINECONE_API_KEY=

# optional - defaults shown
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
PINECONE_INDEX=vectra-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# optional - keep sessions + answer cache in Redis (needed when running more than one instance)
REDIS_URL=
